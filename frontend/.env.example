# Optional: override alerts worker URL (default: https://turbolong-alerts.turbolong.workers.dev)
# VITE_ALERTS_WORKER_URL=http://127.0.0.1:8787

# Optional: override the Aquarius routing API (default: https://amm-api.aqua.network/api/external/v1).
# Auth-free, so there is no key to set. This is the repoint switch if Aquarius
# moves host or path — see docs/aquarius-rate-fallback.md. Feeds the Compare
# view's DEX Rate column and Best Rate badge, the Swap cross-check, and the
# status page's Aquarius health row.
# VITE_AQUARIUS_API=https://amm-api.aqua.network/api/external/v1

# Stellar Broker partner key: DO NOT set this in production builds — anything
# prefixed VITE_ ships in the public JS bundle. In prod the swap WebSocket goes
# through the alerts worker relay (/broker/ws), which injects the key from the
# STELLAR_BROKER_PARTNER_KEY wrangler secret. Only set this locally to bypass
# the relay and hit api.stellar.broker directly during development.
# VITE_STELLAR_BROKER_PARTNER_KEY=dev-only-partner-key
